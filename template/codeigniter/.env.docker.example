# ==============================================================================
# Template Variabel Environment Runtime Docker - CodeIgniter (Pemkab Landak)
# ==============================================================================
# ATURAN PENTING BAGI DEVELOPER:
# 1. File .env.docker.example ini DI-COMMIT ke Git sebagai acuan bagi Admin Server.
# 2. JANGAN PERNAH mengisi password asli, token, atau API key rahasia di file ini!
# 3. Biarkan CI_ENVIRONMENT=production dan isi app.baseURL dengan subdomain produksi.
# ==============================================================================

CI_ENVIRONMENT=production
app.baseURL=https://nama-aplikasi.landakkab.go.id

# ==============================================================================
# Konfigurasi Database Runtime Docker
# PENTING:
# - hostname wajib diisi "db" (nama service container), JANGAN diisi 127.0.0.1!
# - username wajib nama user biasa (misal: db_user), DILARANG menggunakan "root"!
# ==============================================================================
database.default.hostname=db
database.default.database=ci_db
database.default.username=db_user
database.default.password=ganti_password_db_user
database.default.DBDriver=MySQLi

# Variabel untuk inisialisasi container MySQL
DB_DATABASE=ci_db
DB_USERNAME=db_user
DB_PASSWORD=ganti_password_db_user
DB_ROOT_PASSWORD=ganti_password_root_mysql

IMAGE_TAG=development
