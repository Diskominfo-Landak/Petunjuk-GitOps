# Template variabel environment untuk runtime Docker Node.js
# Salin menjadi .env saat deploy di server (chmod 600 .env)
# JANGAN MENYIMPAN PASSWORD ATAU SECRET ASLI DI FILE INI!

NODE_ENV=production
PORT=3000
APP_NAME=Aplikasi-NodeJS-Landak

# Versi image container (diatur otomatis oleh CI/CD atau skrip rilis)
IMAGE_TAG=development

# Konfigurasi Database (jika aplikasi menggunakan DB)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=contoh_password_db_rahasia
DB_ROOT_PASSWORD=contoh_password_root_rahasia
