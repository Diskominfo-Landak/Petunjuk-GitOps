APP_NAME=NamaAplikasi
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_DENGAN_ARTISAN
APP_DEBUG=false
APP_URL=https://aplikasi.landakkab.go.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (Gunakan service "db" jika pakai container bawaan, atau IP terpusat jika ada)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nama_db
DB_USERNAME=db_user
DB_PASSWORD=rahasia_db_user
DB_ROOT_PASSWORD=rahasia_root_mysql

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Tag image default (di VM dev biarkan development, di VM prod diatur oleh release.sh)
IMAGE_TAG=development
