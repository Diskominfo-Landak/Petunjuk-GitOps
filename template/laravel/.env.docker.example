# ==============================================================================
# Template Variabel Environment Runtime Docker - Laravel (Pemkab Landak)
# ==============================================================================
# ATURAN PENTING BAGI DEVELOPER:
# 1. File .env.docker.example ini DI-COMMIT ke Git sebagai acuan bagi Admin Server.
# 2. JANGAN PERNAH mengisi password asli, token, atau API key rahasia di file ini!
# 3. Biarkan APP_ENV=production dan APP_DEBUG=false (standar keamanan default).
# 4. Isi APP_URL langsung dengan rencana alamat subdomain produksi resmi aplikasi.
# ==============================================================================

APP_NAME=NamaAplikasi
APP_ENV=production
APP_KEY=base64:ISI_DI_ENV_LOKAL_DAN_SERVER
APP_DEBUG=false
APP_URL=https://nama-aplikasi.landakkab.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ==============================================================================
# Konfigurasi Database Runtime Docker
# PENTING:
# - DB_HOST wajib diisi "db" (nama service container), JANGAN diisi 127.0.0.1!
# - DB_USERNAME wajib nama user biasa (misal: db_user), DILARANG menggunakan "root"!
#   (Container MySQL 8.4 akan menolak start jika MYSQL_USER diisi "root").
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nama_db
DB_USERNAME=nama_db_user
DB_PASSWORD=ganti_password_db_user
DB_ROOT_PASSWORD=ganti_password_root_mysql

# Kompatibilitas driver broadcast (Laravel <= 10 memakai DRIVER, Laravel 11+ memakai CONNECTION)
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Tag image default (di VM dev biarkan development, di VM prod diatur otomatis oleh release.sh)
IMAGE_TAG=development
