# Template variabel environment untuk runtime Docker PHP Native
# Salin menjadi .env saat deploy di server (chmod 600 .env)
# JANGAN MENYIMPAN PASSWORD ATAU SECRET ASLI DI FILE INI!

APP_NAME=Aplikasi-PHP-Native-Landak
APP_ENV=production
APP_URL=https://nama-aplikasi.landakkab.go.id
IMAGE_TAG=development

# Konfigurasi Koneksi Database
# PENTING:
# - DB_HOST wajib "db" (nama service container), JANGAN diisi 127.0.0.1!
# - DB_USERNAME wajib nama user biasa, DILARANG menggunakan "root"!
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=contoh_password_db_rahasia
DB_ROOT_PASSWORD=contoh_password_root_rahasia
